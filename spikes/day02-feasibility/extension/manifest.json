{
  "manifest_version": 3,
  "name": "Focus Buddy — Day 2 feasibility spike",
  "version": "0.0.2",
  "description": "Throwaway spike. Logs tab/idle/alarm events locally; tests side panel, offscreen audio, notifications, overlay injection.",
  "minimum_chrome_version": "120",
  "permissions": ["tabs", "idle", "alarms", "storage", "sidePanel", "offscreen", "notifications", "scripting"],
  "optional_host_permissions": ["<all_urls>"],
  "background": { "service_worker": "sw.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "Focus Buddy spike" },
  "commands": {
    "mute-all": {
      "suggested_key": { "default": "Alt+Shift+M" },
      "description": "Spike: mute all and pause"
    }
  }
}
